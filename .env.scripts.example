# データ投入スクリプト（scripts/data/ingest.mjs）用の設定。
# .env.scripts にコピーして使ってください（.gitignore 済み）。
#
# service_role キーは RLS を無視できる管理者キーです。
# ブラウザに出す VITE_ 変数には絶対に入れず、Vercel にも設定しないでください。
# 漏れた場合は Supabase の Project Settings から即座にローテートします。
SUPABASE_URL=https://kzhlaltjthxlbxvskcpe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 巡回時に名乗る User-Agent（連絡先を入れてください）
ARTMARK_USER_AGENT=ArtMarkBot/0.1 (+https://artmark-web.vercel.app; contact: you@example.com)
# 同一ホストへの最小リクエスト間隔（ミリ秒）
ARTMARK_CRAWL_INTERVAL_MS=1000
